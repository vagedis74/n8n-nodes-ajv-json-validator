    {
      "parameters": {
        "jsCode": "// Query crt.sh Certificate Transparency logs for the domain\nconst domain = $input.first().json.query.domain;\n\nif (!domain) {\n  return [{ json: { error: 'Domain parameter is required', renewalNeeded: true, daysUntilExpiry: -1 } }];\n}\n\ntry {\n  const response = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `https://crt.sh/?q=${encodeURIComponent(domain)}&output=json`,\n    headers: { 'User-Agent': 'n8n-cert-automation/1.0' },\n    returnFullResponse: true,\n    json: true,\n  });\n\n  const certs = Array.isArray(response.body) ? response.body : [];\n  const now = new Date();\n\n  const activeCerts = certs\n    .filter(c => new Date(c.not_after) > now)\n    .sort((a, b) => new Date(b.not_after) - new Date(a.not_after));\n\n  const latestCert = activeCerts[0] || null;\n  const daysUntilExpiry = latestCert\n    ? Math.floor((new Date(latestCert.not_after) - now) / (1000 * 60 * 60 * 24))\n    : -1;\n\n  return [{\n    json: {\n      domain,\n      totalCertsFound: certs.length,\n      activeCerts: activeCerts.length,\n      renewalNeeded: daysUntilExpiry < 30,\n      daysUntilExpiry,\n      latestCert: latestCert ? {\n        commonName: latestCert.common_name,\n        issuer: latestCert.issuer_name,\n        notBefore: latestCert.not_before,\n        notAfter: latestCert.not_after,\n        serialNumber: latestCert.serial_number\n      } : null\n    }\n  }];\n} catch (err) {\n  return [{ json: { error: `Failed to query crt.sh: ${err.message}`, domain, renewalNeeded: true, daysUntilExpiry: -1 } }];\n}"
      },
      "id": "2d700f5c-2584-43dc-855b-42d229bd0dd3",
      "name": "Query crt.sh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

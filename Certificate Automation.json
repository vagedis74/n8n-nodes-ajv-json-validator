      "parameters": {
        "jsCode": "// Collect all certificate items into a single response array\nconst items = $input.all();\nconst certificates = items.map(item => item.json);\n\nreturn [{\n  json: {\n    count: certificates.length,\n    certificates\n  }\n}];"

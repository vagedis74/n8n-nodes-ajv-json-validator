    {
      "parameters": {
        "jsCode": "// Validate domain and whitelist the file name to prevent path traversal\nconst domain = $input.first().json.query.domain;\nconst file = $input.first().json.query.file;\n\nconst allowedFiles = ['fullchain.pem', 'privkey.pem', 'cert.pem', 'chain.pem'];\n\nif (!allowedFiles.includes(file)) {\n  throw new Error(`Invalid file name: '${file}'. Allowed: ${allowedFiles.join(', ')}`);\n}\n\nconst domainRegex = /^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])$/;\nif (!domain || !domainRegex.test(domain) || domain.includes('..')) {\n  throw new Error(`Invalid domain: ${domain}`);\n}\n\n// Read from .n8n-files/certs (volume mount of /etc/letsencrypt)\nconst filePath = `/home/node/.n8n-files/certs/live/${domain}/${file}`;\n\nreturn [{ json: { filePath, fileName: file, domain } }];"
      },

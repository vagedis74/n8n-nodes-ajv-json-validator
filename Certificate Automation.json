    {
      "parameters": {
        "jsCode": "// Validate domain and password for PFX generation\nconst domain = $input.first().json.query.domain;\nconst password = $input.first().json.query.password || 'changeit';\n\nconst domainRegex = /^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])$/;\nif (!domain || !domainRegex.test(domain) || domain.includes('..')) {\n  throw new Error(`Invalid domain: ${domain}`);\n}\n\n// Sanitize password: allow alphanumeric and basic punctuation only\nconst safePassword = password.replace(/[^a-zA-Z0-9!@#%^&*()_+=.-]/g, '');\nif (!safePassword) {\n  throw new Error('Invalid password');\n}\n\nconst basePath = `/home/node/.n8n-files/certs/live/${domain}`;\nconst pfxPath = `/home/node/.n8n-files/certs/${domain}-legacy.pfx`;\n\n// Build the openssl command with -legacy for 3DES (Windows 2012 R2 / .NET 4.5 compat)\nconst cmd = `openssl pkcs12 -export -legacy -out \"${pfxPath}\" -inkey \"${basePath}/privkey.pem\" -in \"${basePath}/fullchain.pem\" -passout \"pass:${safePassword}\" 2>&1 || openssl pkcs12 -export -out \"${pfxPath}\" -inkey \"${basePath}/privkey.pem\" -in \"${basePath}/fullchain.pem\" -passout \"pass:${safePassword}\" 2>&1`;\n\nreturn [{ json: { command: cmd, pfxPath, domain, fileName: `${domain}.pfx` } }];"
      },
      "id": "8f6509dd-fc62-472e-9e9d-74ecd9acedcd",
      "name": "Validate PFX Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        1296
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate PFX using openssl (requires NODE_FUNCTION_ALLOW_BUILTIN=child_process)\nconst { execSync } = require('child_process');\nconst command = $input.first().json.command;\n\ntry {\n  const output = execSync(command, { encoding: 'utf8', timeout: 30000 });\n  return [{ json: { success: true, output: output || 'PFX generated successfully' } }];\n} catch (error) {\n  // execSync throws on non-zero exit, but the fallback command (after ||) may succeed\n  // Check if the PFX file was actually created\n  const pfxPath = $('Validate PFX Request').first().json.pfxPath;\n  try {\n    const fs = require('fs');\n    fs.accessSync(pfxPath);\n    return [{ json: { success: true, output: 'PFX generated (with warnings)' } }];\n  } catch (e) {\n    throw new Error('Failed to generate PFX: ' + error.message);\n  }\n}"
      },

    {
      "parameters": {
        "jsCode": "// Validate domain(s) parameter - supports comma-separated list for CN + SANs\nconst rawDomain = $input.first().json.query.domain;\n\nif (!rawDomain) {\n  throw new Error('Domain parameter is required.');\n}\n\nconst domainRegex = /^(\\*\\.)?[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*\\.[a-zA-Z]{2,}$/;\n\n// Split comma-separated domains and validate each\nconst domains = rawDomain.split(',').map(d => d.trim()).filter(d => d);\n\nfor (const d of domains) {\n  if (!domainRegex.test(d)) {\n    throw new Error(`Invalid domain: ${d}. Must be a valid FQDN.`);\n  }\n  if (d.includes('..') || d.includes('/')) {\n    throw new Error(`Invalid domain characters detected: ${d}`);\n  }\n}\n\nif (domains.length === 0) {\n  throw new Error('At least one domain is required.');\n}\n\nreturn [{ json: { domain: domains.join(','), validated: true } }];"
      },
      "id": "2f2c90b9-cdfb-47e8-a006-141d05df609f",
      "name": "Validate Domain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        272
      ]
    },

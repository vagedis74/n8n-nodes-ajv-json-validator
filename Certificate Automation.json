    {
      "parameters": {
        "jsCode": "// Format the certbot node result into a structured response\nconst item = $input.first().json;\nconst domain = $('Validate Domain').first().json.domain;\n\nconst success = item.success === true;\nconst certPath = item.certificatePath || `/etc/letsencrypt/live/${domain}`;\n\nreturn [{\n  json: {\n    success,\n    domain,\n    message: success\n      ? `Certificate issued successfully for ${domain}`\n      : `Certificate issuance failed for ${domain}`,\n    certPath: success ? certPath : null,\n    privateKeyPath: item.privateKeyPath || null,\n    expiryDate: item.expiryDate || null,\n    availableFiles: success\n      ? ['fullchain.pem', 'privkey.pem', 'cert.pem', 'chain.pem']\n      : [],\n    output: (item.rawOutput || '').substring(0, 2000)\n  }\n}];"
      },
